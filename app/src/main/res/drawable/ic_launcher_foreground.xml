<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Background Globe representing the Web (World Wide Web) -->
    <group
        android:translateX="54"
        android:translateY="50">
        <!-- Circular outer limit filled with transparent overlay tint -->
        <path
            android:fillColor="#33D0BCFF"
            android:pathData="M 0,-24 A 24,24 0 1,1 -0.1,-24 Z" />
        <!-- Horizontal grid line -->
        <path
            android:strokeColor="#80FFFFFF"
            android:strokeWidth="1.5"
            android:pathData="M -24,0 L 24,0" />
        <!-- Vertical grid line -->
        <path
            android:strokeColor="#80FFFFFF"
            android:strokeWidth="1.5"
            android:pathData="M 0,-24 L 0,24" />
        <!-- Curved longitude grid lines -->
        <path
            android:strokeColor="#80FFFFFF"
            android:strokeWidth="1.5"
            android:fillColor="#00000000"
            android:pathData="M 0,-24 C -12,-12 -12,12 0,24 C 12,12 12,-12 0,-24 Z" />
    </group>

    <!-- Foreground Floating Browser Window Card -->
    <!-- Shadow for the floating card -->
    <path
        android:fillColor="#4D000000"
        android:pathData="M 32,38 h 44 c 3,0 5,2 5,5 v 26 c 0,3 -2,5 -5,5 H 32 c -3,0 -5,-2 -5,-5 V 43 c 0,-3 2,-5 5,-5 Z"
        android:translateX="2"
        android:translateY="2" />

    <!-- Main Window Background -->
    <path
        android:fillColor="#FEF7FF"
        android:pathData="M 32,38 h 44 c 3,0 5,2 5,5 v 26 c 0,3 -2,5 -5,5 H 32 c -3,0 -5,-2 -5,-5 V 43 c 0,-3 2,-5 5,-5 Z" />

    <!-- Window Top Header Bar -->
    <path
        android:fillColor="#E7E0EC"
        android:pathData="M 32,38 h 44 c 3,0 5,2 5,5 v 6 H 27 v -6 c 0,-3 2,-5 5,-5 Z" />

    <!-- Three Window Command Buttons (Left Side of header) -->
    <path
        android:fillColor="#FF5F56"
        android:pathData="M 33.5,44 A 1.5,1.5 0 1,1 33.4,44 Z" />
    <path
        android:fillColor="#FFBD2E"
        android:pathData="M 38,44 A 1.5,1.5 0 1,1 37.9,44 Z" />
    <path
        android:fillColor="#27C93F"
        android:pathData="M 42.5,44 A 1.5,1.5 0 1,1 42.4,44 Z" />

    <!-- Miniature Rounded Address Bar inside Header -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 48,41.5 h 24 c 1,0 1.5,0.5 1.5,1.5 v 0 c 0,1 -0.5,1.5 -1.5,1.5 H 48 c -1,0 -1.5,-0.5 -1.5,-1.5 v 0 c 0,-1 0.5,-1.5 1.5,-1.5 Z" />

    <!-- Magnifying Glass Icon inside the browser body -->
    <group
        android:translateX="54"
        android:translateY="59">
        <path
            android:strokeColor="#6750A4"
            android:strokeWidth="2.5"
            android:fillColor="#00000000"
            android:pathData="M -4,-4 A 5,5 0 1,1 -3.9,-4" />
        <path
            android:strokeColor="#6750A4"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M 0.5,0.5 L 5.5,5.5" />
    </group>
</vector>
